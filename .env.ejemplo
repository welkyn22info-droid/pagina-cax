# Copiar a .env y reemplazar los valores ficticios antes de levantar
# docker-compose.yml. Ninguna credencial real va en el repositorio
# (sección 20, convención de configuración).

# Postgres — superusuario (solo para crear la base y correr migraciones)
DB_SUPERUSUARIO=postgres
DB_CLAVE_SUPER=cambiar_esta_clave_super

# Postgres — rol de aplicación (sin BYPASSRLS; ver operacion/preparar_rol.sql)
DB_CLAVE_APP=cambiar_esta_clave_app

# API
SECRETO_JWT=generar_con_openssl_rand_-hex_32

# Web (Next.js) — en producción, detrás de Nginx, el navegador llama /api/*
NEXT_PUBLIC_API_BASE=/api
